# =============================================================================
# CrossPilot 环境变量样例
# 用法：cp .env.example .env  然后填入真实值
# 铁律：任何密钥/凭证一律走环境变量，禁止硬编码（PRD 约束 C5 / NFR-S-02）
# =============================================================================

# ---------- 运行环境 ----------
APP_ENV=dev                      # dev | test | staging | prod
DEBUG=true
TZ=UTC                           # 全系统统一 UTC，展示层再转本地时区
LOG_LEVEL=INFO
LOG_FORMAT=json                  # json | console

# ---------- 服务 ----------
API_HOST=0.0.0.0
API_PORT=8000
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# ---------- 主库（PostgreSQL 16）----------
# 应用角色：非表 owner，受 RLS 约束（多租户第二道防线）
DATABASE_URL=postgresql+asyncpg://crosspilot_app:crosspilot_app_pwd@localhost:5432/crosspilot
# 迁移角色：表 owner，用于 Alembic
DATABASE_MIGRATION_URL=postgresql+asyncpg://crosspilot_owner:crosspilot_owner_pwd@localhost:5432/crosspilot
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=false
DB_STATEMENT_TIMEOUT_MS=30000

# ---------- Redis 7（缓存 / 限流 / 锁 / 队列）----------
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ---------- 鉴权（双 Token：Access 15min / Refresh 7d）----------
JWT_SECRET=change-me-to-a-64-char-random-string
JWT_ALG=HS256
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7
LOGIN_MAX_FAILURES=5              # 连续失败锁定阈值
LOGIN_LOCK_MINUTES=15

# ---------- 平台凭证字段级加密（AES-256-GCM）----------
# 生成：python -c "import os,base64;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
CREDENTIAL_AES_KEY=

# ---------- 平台应用凭证（M1 拿到 Sandbox App Key 后填入）----------
PLATFORM_AMAZON_APP_KEY=
PLATFORM_AMAZON_APP_SECRET=
PLATFORM_SHOPEE_APP_KEY=
PLATFORM_SHOPEE_APP_SECRET=
PLATFORM_LAZADA_APP_KEY=
PLATFORM_LAZADA_APP_SECRET=
PLATFORM_TIKTOK_APP_KEY=
PLATFORM_TIKTOK_APP_SECRET=
# OAuth 回调地址（必须公网可达，M0-10）
OAUTH_REDIRECT_BASE_URL=http://localhost:8000/api/v1/shops/oauth/callback

# ---------- 对象存储（MinIO / S3）----------
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_PRODUCT_IMAGE=crosspilot-product
S3_BUCKET_CERTIFICATE=crosspilot-cert      # 私有桶，仅签名 URL 可访问
S3_BUCKET_EXPORT=crosspilot-export
S3_USE_SSL=false

# ---------- 通知渠道（4 种）----------
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
WECOM_WEBHOOK=
DINGTALK_WEBHOOK=

# ---------- 同步引擎（M2）----------
# 平台 QPS 不在这里，见 backend/app/adapters/quotas.py。
# 连续 429 把有效 QPS 乘以 SYNC_SLOWDOWN_RATIO，最低降到 SYNC_PENALTY_FLOOR。
SYNC_SLOWDOWN_RATIO=0.5
SYNC_PENALTY_FLOOR=0.25
SYNC_RECOVER_AFTER_SUCCESSES=20
SYNC_BACKOFF_SECONDS=1,4,16
SYNC_JITTER_RATIO=0.2
SYNC_CIRCUIT_FAILURE_RATIO=0.5
SYNC_CIRCUIT_MIN_SAMPLES=4
SYNC_CIRCUIT_WINDOW=20
SYNC_CIRCUIT_OPEN_SECONDS=300
SYNC_BLOOM_BIT_SIZE=1048576
SYNC_BLOOM_HASH_COUNT=7
SYNC_BEAT_LOCK_TTL_SECONDS=240
SYNC_STATE_TTL_SECONDS=3600
# 订单游标向前重叠的秒数。多拉的订单靠幂等键去重。
SYNC_ORDER_OVERLAP_SECONDS=300
SYNC_ORDER_INITIAL_LOOKBACK_SECONDS=86400
SYNC_ORDER_INTERVAL_SECONDS=60
SYNC_ORDER_MAX_PAGES=20

# ---------- 前端（Vite 注入）----------
VITE_API_BASE_URL=/api/v1
VITE_APP_TITLE=CrossPilot
